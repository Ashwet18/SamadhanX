# SamadhanX Environment Configuration Template
# Copy this file to .env and update values for your environment

# ===================================
# APPLICATION CONFIGURATION
# ===================================
APP_NAME=SamadhanX
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# ===================================
# DATABASE CONFIGURATION
# ===================================
# Primary PostgreSQL Database
DATABASE_URL=postgresql://samadhanx:samadhanx_dev_password@localhost:5432/samadhanx
POSTGRES_USER=samadhanx
POSTGRES_PASSWORD=samadhanx_dev_password
POSTGRES_DB=samadhanx
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database Connection Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ===================================
# AUTHENTICATION & SECURITY
# ===================================
# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Security
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080

# ===================================
# FRONTEND CONFIGURATION
# ===================================
# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=SamadhanX
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_ENVIRONMENT=development

# ===================================
# AI/ML SERVICES
# ===================================
# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-your-organization-id
EMBEDDING_MODEL=text-embedding-ada-002
LLM_MODEL=gpt-4
MAX_TOKENS=2000
AI_TEMPERATURE=0.7
AI_REQUEST_TIMEOUT=60

# Vector Database (pgvector)
VECTOR_DIMENSION=1536
SIMILARITY_THRESHOLD=0.8

# ===================================
# EXTERNAL SERVICES
# ===================================
# Maps and Geocoding
MAPS_API_KEY=your-google-maps-api-key
GEOCODING_PROVIDER=google
MAPS_DEFAULT_ZOOM=10

# Email/SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_TLS=true
SMTP_SSL=false
FROM_EMAIL=noreply@samadhanx.gov.in
FROM_NAME=SamadhanX Platform

# SMS Gateway
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ===================================
# FILE STORAGE
# ===================================
# Storage Backend (local, s3, gcs)
STORAGE_BACKEND=local
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,text/plain

# Local Storage
LOCAL_STORAGE_PATH=./uploads
LOCAL_STORAGE_URL=http://localhost:8000/uploads

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET=samadhanx-media
S3_PUBLIC_READ=true

# Google Cloud Storage
GCS_BUCKET=samadhanx-storage
GOOGLE_APPLICATION_CREDENTIALS=./gcs-credentials.json

# ===================================
# REDIS CONFIGURATION
# ===================================
# Redis for Caching and Sessions
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# Cache Configuration
CACHE_TTL=3600
CACHE_KEY_PREFIX=samadhanx:

# ===================================
# BACKGROUND JOBS
# ===================================
# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=Asia/Kolkata

# ===================================
# MONITORING & LOGGING
# ===================================
# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/samadhanx.log
LOG_MAX_SIZE=100MB
LOG_BACKUP_COUNT=5

# Sentry Error Tracking
SENTRY_DSN=your-sentry-dsn-url
SENTRY_ENVIRONMENT=development
SENTRY_SAMPLE_RATE=1.0

# Metrics and Monitoring
METRICS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_ENABLED=true

# ===================================
# API CONFIGURATION
# ===================================
# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
RATE_LIMIT_STORAGE=redis

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# API Documentation
DOCS_ENABLED=true
DOCS_URL=/docs
REDOC_URL=/redoc

# ===================================
# DEVELOPMENT TOOLS
# ===================================
# Hot Reloading
RELOAD_ON_CHANGE=true
RELOAD_DIRS=./backend/app

# Debug Toolbar
DEBUG_TOOLBAR=true
DEBUG_SQL=false

# Testing
TEST_DATABASE_URL=postgresql://test_user:test_pass@localhost:5432/test_samadhanx
TEST_REDIS_URL=redis://localhost:6379/15

# ===================================
# PRODUCTION OVERRIDES
# ===================================
# These should be overridden in production

# Security
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_CONTENT_TYPE_NOSNIFF=true
# SECURE_BROWSER_XSS_FILTER=true

# Performance
# ENABLE_GZIP=true
# ENABLE_CACHING=true
# CDN_URL=https://cdn.samadhanx.gov.in

# Scaling
# MAX_WORKERS=4
# WORKER_TIMEOUT=30
# KEEP_ALIVE=2

# ===================================
# FEATURE FLAGS
# ===================================
# Enable/Disable Features
FEATURE_AI_ANALYSIS=true
FEATURE_DUPLICATE_DETECTION=true
FEATURE_REAL_TIME_NOTIFICATIONS=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_INDUSTRY_PARTNERSHIPS=true
FEATURE_IMPACT_MEASUREMENT=true

# Experimental Features
EXPERIMENTAL_FEATURES=false
FEATURE_BLOCKCHAIN_INTEGRATION=false
FEATURE_IOT_INTEGRATION=false

# ===================================
# LOCALIZATION
# ===================================
# Supported Languages
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,bn,or,ur
TIMEZONE=Asia/Kolkata

# Currency
DEFAULT_CURRENCY=INR
CURRENCY_SYMBOL=₹

# ===================================
# COMPLIANCE & AUDIT
# ===================================
# Data Retention
DATA_RETENTION_DAYS=2555
LOG_RETENTION_DAYS=365
AUDIT_LOG_RETENTION_DAYS=2555

# Privacy
GDPR_COMPLIANCE=true
DATA_ANONYMIZATION=true
CONSENT_TRACKING=true

# Backup
AUTOMATED_BACKUP=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE=s3://samadhanx-backups/

# ===================================
# INTEGRATION ENDPOINTS
# ===================================
# Government Systems
GOVT_API_BASE_URL=https://api.gov.in
GOVT_API_KEY=your-government-api-key
AADHAAR_VERIFICATION_URL=https://uidai.gov.in/verify

# University Systems
UNIVERSITY_INTEGRATION_ENABLED=false
UNIVERSITY_API_ENDPOINTS=

# Third-party Services
PAYMENT_GATEWAY_URL=
DOCUMENT_VERIFICATION_API=
GEOSPATIAL_API_URL=

# ===================================
# MOBILE APP CONFIGURATION
# ===================================
# Push Notifications
FCM_SERVER_KEY=your-firebase-server-key
FCM_SENDER_ID=your-firebase-sender-id
APNS_KEY_ID=your-apple-push-key-id
APNS_TEAM_ID=your-apple-team-id

# Mobile API
MOBILE_API_VERSION=v1
MOBILE_MIN_VERSION=1.0.0
MOBILE_FORCE_UPDATE=false